# Normalise line endings in the repository regardless of the contributor's OS.
# Without this, a Windows checkout commits CRLF and every later diff on Linux
# shows the whole file as changed.
* text=auto eol=lf

# Binary: never normalise, never diff as text.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.woff2 binary

# Generated from contracts/openapi.yaml and the SQL. Collapsed in review and
# left out of the language statistics; CI checks they match their sources.
pnpm-lock.yaml linguist-generated=true -diff
services/api/go.sum linguist-generated=true -diff
services/api/internal/adapter/httpapi/oas/** linguist-generated=true
services/api/internal/adapter/postgres/sqlcdb/** linguist-generated=true
apps/web/src/lib/api/generated/** linguist-generated=true
